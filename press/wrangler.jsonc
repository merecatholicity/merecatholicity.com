// Lérins Press: a Worker with no code, only static assets. It serves dist/ (make build)
// at press.merecatholicity.com. Deployed by .github/workflows/press.yml on a merge that
// touches press/. The DNS record the route needs is Terraform's (terraform/dns.tf, `press`).
// The route is wrangler's.
{
  "name": "lerins-press",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // every page is prerendered at <path>/index.html; anything else answers dist/404.html
    // with a 404
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "press.merecatholicity.com/*", "zone_name": "merecatholicity.com" }],
  "workers_dev": false,
  "preview_urls": false
}
