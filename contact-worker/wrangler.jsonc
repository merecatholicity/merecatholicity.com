// Contact form handler for merecatholicity.com. Free tier only:
// sends are to a verified destination address, which is free on all plans.
// Deploy with: make worker (from the repo root)
{
  "name": "merecatholicity-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "observability": { "enabled": true },
  "send_email": [{ "name": "EMAIL" }],
  // Per-IP throttle. The simple binding supports only 10s/60s windows, so this
  // caps bursts at 3/min/IP; Turnstile remains the first gate in front of it.
  "ratelimits": [
    { "name": "SEND_LIMIT", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
    // The press's mailing list doors (src/list.ts), per IP, before the Turnstile call.
    { "name": "LIST_LIMIT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Lérins Press's mailing list: written by /subscribe and /unsubscribe, read by nothing here.
  // Terraform owns the database (press_list in terraform/d1.tf); its schema is migrations/, applied
  // by workers.yml before this worker deploys. The comments worker binds it for the backup alone.
  "d1_databases": [
    { "binding": "LIST", "database_name": "lerins-press-list", "database_id": "ff31e00f-d927-45e1-be87-168ac77507b8", "migrations_dir": "migrations" }
  ],
  "vars": {
    // Turnstile tokens are accepted only when solved on one of these hosts.
    // Leave unset in local dev so the always-pass test key still works.
    "TURNSTILE_HOSTNAMES": "merecatholicity.com,www.merecatholicity.com,press.merecatholicity.com"
  },
  "routes": [{ "pattern": "contact-api.merecatholicity.com", "custom_domain": true }]
}
