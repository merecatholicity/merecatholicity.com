# Repo-wide ignores. Per-directory build churn is scoped to that directory's own
# .gitignore (see resources/.gitignore for the whole converted-corpus build).

CONTEXT_DUMP.txt

# The book/paper LaTeX build runs in book/ (the Makefile cd's there) and writes
# its intermediates beside the sources; only the final PDFs/docx are copied up
# into the served tree at docs/. Keep the intermediates and the temp html-tex
# out of git. The book/*.tex sources and build-confession.sh stay tracked.
book/*.aux
book/*.log
book/*.out
book/*.toc
book/*.pdf
book/*.dvi
book/memorandum-body-html.tex

# Cloudflare Worker local state and secrets — never in git.
.wrangler/
contact-worker/.wrangler/
contact-worker/node_modules/
comments-worker/.wrangler/
comments-worker/.dev.vars
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Database dumps NEVER belong in the repo — backups live in R2. Belt and
# suspenders against a stray `git add -A` grabbing an export.
comments-backup.sql
comments-worker/backups/
backups/
*.sql.gz

# Python bytecode anywhere (scripts/, resources/, …).
__pycache__/

# librarian secrets and the private shelf. librarian/private is an INDEPENDENT
# nested git repo pushed to the PRIVATE repo merecatholicity/private-shelf
# (never a submodule: the Pages Jekyll builder cannot fetch private submodules).
# Ignored here; restore with a second clone into this path.
librarian/.key
librarian/private/

# merecat-local: the offline GPU twin. Its CODE (local/*.py, mc_config.yml,
# README, the systemd units) is tracked; its DERIVED state is not — the embedded
# corpus, the sqlite index, and the reranker GGUF are rebuilt by
# `python local/build_index.py`. The live local prompt and key are private;
# the committed persona.local.example.md is the starter a fresh clone copies.
local/data/
local/models/
local/serve.key
local/persona.local.md
