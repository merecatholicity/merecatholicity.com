# Repo-wide ignores. Per-directory build churn is scoped to that directory's own
# .gitignore (see resources/.gitignore for the whole converted-corpus build).

CONTEXT_DUMP.txt

# The book/paper LaTeX build runs in book/ (the Makefile cd's there) and writes
# its intermediates beside the sources; only the final PDFs/docx are copied up
# into the served tree at docs/. Keep the intermediates and the temp html-tex
# out of git. The book/*.tex sources and build-confession.sh stay tracked.
book/*.aux
book/*.log
book/*.out
book/*.toc
book/*.pdf
book/*.dvi
book/memorandum-body-html.tex
# The resources html loops write <id>-body-html.tex, convert it, then rm it.
# Transient — but since the loops fail hard now (|| exit 1), a failed run
# leaves one behind, and it must never be mistaken for a committed source.
resources/*-body-html.tex

# npm: the JS toolchain (Tailwind, esbuild, eslint, wrangler) is a per-project
# devDependency set, restored from the committed package-lock.json with `npm ci`.
# node_modules/ is build machinery — never committed, never installed with -g or
# sudo. See README (setup) and CLAUDE.md (the npm discipline).
node_modules/

# Cloudflare Worker local state and secrets — never in git.
.wrangler/
contact-worker/.wrangler/
contact-worker/node_modules/
comments-worker/.wrangler/
comments-worker/.dev.vars
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Database dumps NEVER belong in the repo — backups live in R2. Belt and
# suspenders against a stray `git add -A` grabbing an export.
comments-backup.sql
comments-worker/backups/
backups/
*.sql.gz

# Python bytecode anywhere (scripts/, resources/, …).
__pycache__/

# librarian secrets and the private shelf. librarian/private is an INDEPENDENT
# nested git repo pushed to the PRIVATE repo merecatholicity/private-shelf
# (never a submodule: the Pages Jekyll builder cannot fetch private submodules).
# Ignored here; restore with a second clone into this path.
librarian/.key
# the ingest's parse ledger: a memory of what was parsed, never a source
librarian/.ledger.json
librarian/private/

# Interactive test-kit identity keys (throwaway, never committed).
webtest/.testkeys

# The published PDFs live in R2 (files.merecatholicity.com) since 2026-09-08,
# not in git and not on Pages. docs/ had reached 621 MB against a HARD 1 GB
# GitHub Pages limit, and 293 MB of that was 244 PDFs. Every previously-shared
# URL still works: a Cloudflare redirect rule maps /X.pdf to the bucket.
# Rebuild them with `make -C resources pdf`; publish with
# `npx wrangler r2 object put merecatholicity-files/<name> --file <path> --remote`.
docs/*.pdf

# THE BUILT SITE (2026-09-08). Pages is deployed from the workflow's artifact,
# not from this branch, so what the build WRITES is output and does not belong
# in git. It had reached 621 MB against a hard 1 GB Pages limit, and 615 of the
# ~800 largest blobs in history were under docs/.
#
# docs/ is a MIXTURE, and the distinction is load-bearing: nav.js, sw.js, the
# vendored libraries, turnstile.html, CNAME, .nojekyll and every image are
# HAND-MAINTAINED SOURCE that lives nowhere else. A blanket `docs/` ignore
# deleted them and broke the build within one commit. Only the generated set is
# listed here — 284 files, 315 MB — and the 297 source files (10 MB) stay.
#
# A clean clone therefore has the sources but not the built pages: `make html`
# builds them, and CI caches the result between runs.
# The corpus pages are generated from content/ and resources/*.tex. These
# FIFTEEN are not: they are hand-written and live nowhere else — the whole app
# (index, community, messages, profile, feed, admin, merecat-ai, journal), the
# contact and away pages, the two prose pages, the Turnstile iframe, and
# Google's site-verification file. Ignoring docs/*.html without these deleted
# every one of them and broke the build twice. A NEW hand page must be added
# here, and tests/py/test_docs_sources.py fails if one is not.
docs/*.html
!docs/admin.html
!docs/away.html
!docs/community.html
!docs/contact.html
!docs/feed.html
!docs/google6ba8200a89171ee8.html
!docs/hours.html
!docs/index.html
!docs/journal.html
!docs/merecat-ai.html
!docs/messages.html
!docs/profile.html
!docs/the-book.html
!docs/turnstile.html
!docs/where-to-begin.html
# kjv.html and douay-rheims.html are small hand-written landing pages: the
# Bible text itself is fetched client-side from kjv.json/dr.json by
# bible-reader.js. The matching .tex files build the PDFs, not these.
!docs/kjv.html
!docs/douay-rheims.html
docs/app.js
docs/comments.js
# `make logos` (pandoc, no TeX) builds this from the book; CI rebuilds it when
# the book changes and whenever it is missing from the cached tree.
docs/Mere_Catholicity_Logos.docx
docs/style.css
docs/version.json
docs/pdfs.txt
docs/sitemap.xml
docs/library-order.json
docs/kjv.json
docs/dr.json
# NOT ignored: emoji/emoji-data.json and avatars/presets/index.json look
# generated but no build target makes them — they come from one-off tooling
# (gemoji, scratchpad/import_presets.py) and are regenerated by hand when the
# packs change. Like the images beside them, they are source.
