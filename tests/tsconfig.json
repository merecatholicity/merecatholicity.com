{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["js/**/*.ts", "purescript/**/*.ts", "_support/client.ts", "_support/ps.ts", "_support/ts.ts", "_support/worker_src.ts", "../scripts/home_prerender.ts", "../scripts/vendor.ts"]
}
