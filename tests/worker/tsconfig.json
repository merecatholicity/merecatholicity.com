{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["**/*.ts", "../_support/*.ts", "../../scripts/response_shapes.ts"],
  "exclude": ["../_support/ps.ts", "../_support/ts.ts"]
}
